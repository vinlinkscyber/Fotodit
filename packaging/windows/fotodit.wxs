<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasPlyraFontLicences ?>
  <?define HasPlyraFontLicences=0 ?>
  <?endif?>
  <Package Name="Fotodit" Manufacturer="Plyra" Version="$(var.Version)" UpgradeCode="D9660F32-2D0A-4ABE-B73D-17BE25F1542C" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Fotodit image editor" Manufacturer="Plyra" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Fotodit is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="FotoditIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FotoditIcon.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Plyra">
        <Directory Id="INSTALLFOLDER" Name="Fotodit" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by FotoditApp). -->

    <Feature Id="Main" Title="Fotodit" Level="1">
      <?if $(var.HasPlyraFontLicences) = 1 ?>
      <ComponentGroupRef Id="PlyraFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="FotoditFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFotodit" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through fotodit.en-us.wxl. -->
    <Property Id="FotoditVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Fotodit $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Fotodit" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#FotoditExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchFotodit" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasPlyraFontLicences) = 1 ?>
    <ComponentGroup Id="PlyraFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="FotoditFiles" Directory="INSTALLFOLDER">
      <Component Id="FotoditApp" Guid="A6DE41B7-A80F-4C59-A17E-BB68065BF67E">
        <File Id="FotoditExe" Source="$(var.BinDir)\fotodit.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Fotodit" Description="Fotodit image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="FotoditIcon.exe" IconIndex="0" />
        </File>

        <!-- .plyra: Fotodit's own format; Fotodit is its default app. -->
        <ProgId Id="Fotodit.Document" Description="Fotodit Document" Icon="FotoditExe" IconIndex="0">
          <Extension Id="plyra" ContentType="application/x-fotodit">
            <Verb Id="open" Command="Open" TargetFile="FotoditExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Fotodit.PhotoshopDocument" Description="PSD Document" Icon="FotoditExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Fotodit.PhotoshopDocument\shell\open\command" Value="&quot;[#FotoditExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Fotodit.Image" Description="Image" Icon="FotoditExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Fotodit.Image\shell\open\command" Value="&quot;[#FotoditExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psd\OpenWithProgids" Name="Fotodit.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psb\OpenWithProgids" Name="Fotodit.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdn\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ora\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.kra\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.krz\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tif\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tiff\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tga\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.exr\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.hdr\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.avif\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.qoi\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ico\OpenWithProgids" Name="Fotodit.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "fotodit"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe" Name="FriendlyAppName" Value="Fotodit" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\shell\open\command" Value="&quot;[#FotoditExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".plyra" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\fotodit.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fotodit.exe" Value="[#FotoditExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Fotodit" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="FotoditCli">
        <File Id="FotoditCliExe" Source="$(var.BinDir)\fotodit-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
