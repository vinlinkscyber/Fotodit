<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Choose scope before launch checks and directory costing. Never move an existing copy. -->
  <!-- Only for me leaves ALLUSERS unset. Publishing ALLUSERS=2 here makes FindRelatedProducts treat the run as
       per-machine and skip the existing per-user copy, so an interactive upgrade installs beside it
       (two registered products, and uninstall leaves files behind). Checked with real msiexec runs. -->
  <Property Id="INSTALLFOLDER" Secure="yes" />
  <Property Id="PLYRA_SCOPE" Value="user" Secure="yes" />
  <Property Id="PLYRA_U_DIR" Secure="yes"><RegistrySearch Id="PLYRA_U_DIRSearch" Root="HKCU" Key="Software\Fotodit" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="PLYRA_USER_DIR" Action="PlyraUFromDIR" Value="[PLYRA_U_DIR]" After="AppSearch" Sequence="both" Condition="NOT PLYRA_USER_DIR AND PLYRA_U_DIR" />
  <Property Id="PLYRA_U_FOLDER" Secure="yes"><RegistrySearch Id="PLYRA_U_FOLDERSearch" Root="HKCU" Key="Software\Fotodit" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="PLYRA_USER_DIR" Action="PlyraUFromFOLDER" Value="[PLYRA_U_FOLDER]" After="PlyraUFromDIR" Sequence="both" Condition="NOT PLYRA_USER_DIR AND PLYRA_U_FOLDER" />
  <Property Id="PLYRA_U_PATH" Secure="yes"><RegistrySearch Id="PLYRA_U_PATHSearch" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fotodit.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="PLYRA_USER_DIR" Action="PlyraUFromPATH" Value="[PLYRA_U_PATH]" After="PlyraUFromFOLDER" Sequence="both" Condition="NOT PLYRA_USER_DIR AND PLYRA_U_PATH" />
  <Property Id="PLYRA_U_EXEFOLDER" Secure="yes"><RegistrySearch Id="PLYRA_ULegacyFolder" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fotodit.exe" Type="file" /></Property>
  <Property Id="PLYRA_U_EXE" Secure="yes"><RegistrySearch Id="PLYRA_ULegacyExe" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fotodit.exe" Type="file"><FileSearch Id="PLYRA_ULegacyFile" Name="fotodit.exe" /></RegistrySearch></Property>
  <SetProperty Id="PLYRA_USER_DIR" Action="PlyraUFromLegacyExe" Value="[PLYRA_U_EXEFOLDER]" After="PlyraUFromPATH" Sequence="both" Condition="NOT PLYRA_USER_DIR AND PLYRA_U_EXEFOLDER AND PLYRA_U_EXE" />
  <Property Id="PLYRA_USER_DIR" Secure="yes" />
  <Property Id="PLYRA_M_DIR" Secure="yes"><RegistrySearch Id="PLYRA_M_DIRSearch" Root="HKLM" Key="Software\Fotodit" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="PLYRA_MACHINE_DIR" Action="PlyraMFromDIR" Value="[PLYRA_M_DIR]" After="PlyraUFromLegacyExe" Sequence="both" Condition="NOT PLYRA_MACHINE_DIR AND PLYRA_M_DIR" />
  <Property Id="PLYRA_M_FOLDER" Secure="yes"><RegistrySearch Id="PLYRA_M_FOLDERSearch" Root="HKLM" Key="Software\Fotodit" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="PLYRA_MACHINE_DIR" Action="PlyraMFromFOLDER" Value="[PLYRA_M_FOLDER]" After="PlyraMFromDIR" Sequence="both" Condition="NOT PLYRA_MACHINE_DIR AND PLYRA_M_FOLDER" />
  <Property Id="PLYRA_M_PATH" Secure="yes"><RegistrySearch Id="PLYRA_M_PATHSearch" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fotodit.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="PLYRA_MACHINE_DIR" Action="PlyraMFromPATH" Value="[PLYRA_M_PATH]" After="PlyraMFromFOLDER" Sequence="both" Condition="NOT PLYRA_MACHINE_DIR AND PLYRA_M_PATH" />
  <Property Id="PLYRA_M_EXEFOLDER" Secure="yes"><RegistrySearch Id="PLYRA_MLegacyFolder" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fotodit.exe" Type="file" /></Property>
  <Property Id="PLYRA_M_EXE" Secure="yes"><RegistrySearch Id="PLYRA_MLegacyExe" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\fotodit.exe" Type="file"><FileSearch Id="PLYRA_MLegacyFile" Name="fotodit.exe" /></RegistrySearch></Property>
  <SetProperty Id="PLYRA_MACHINE_DIR" Action="PlyraMFromLegacyExe" Value="[PLYRA_M_EXEFOLDER]" After="PlyraMFromPATH" Sequence="both" Condition="NOT PLYRA_MACHINE_DIR AND PLYRA_M_EXEFOLDER AND PLYRA_M_EXE" />
  <Property Id="PLYRA_MACHINE_DIR" Secure="yes" />
  <SetProperty Id="PLYRA_SCOPE" Action="PlyraPreferMachineScope" Value="machine" After="PlyraMFromLegacyExe" Sequence="ui" Condition="ALLUSERS = 1 OR (PLYRA_MACHINE_DIR AND NOT PLYRA_USER_DIR)" />
  <SetProperty Id="INSTALLFOLDER" Action="PlyraRestoreUserFolder" Value="[PLYRA_USER_DIR]" Before="CostInitialize" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1 AND PLYRA_USER_DIR" />
  <!-- The wizard can change the context after Windows Installer has already resolved Program Files for the first one.
       Give the new-install folder explicitly so Everyone never lands in the profile and Only for me never lands in Program Files. -->
  <?if $(sys.BUILDARCH) = x86 ?>
  <SetProperty Id="INSTALLFOLDER" Action="PlyraDefaultMachineFolder" Value="[%ProgramFiles(x86)]\Plyra\Fotodit\" After="PlyraRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="PlyraDefaultMachineFolder32" Value="[%ProgramFiles]\Plyra\Fotodit\" After="PlyraDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND NOT VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="PlyraDefaultUserFolder" Value="[LocalAppDataFolder]Programs\Plyra\Fotodit\" After="PlyraDefaultMachineFolder32" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?else?>
  <SetProperty Id="INSTALLFOLDER" Action="PlyraDefaultMachineFolder" Value="[%ProgramW6432]\Plyra\Fotodit\" After="PlyraRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1" />
  <SetProperty Id="INSTALLFOLDER" Action="PlyraDefaultUserFolder" Value="[LocalAppDataFolder]Programs\Plyra\Fotodit\" After="PlyraDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?endif?>
  <SetProperty Id="INSTALLFOLDER" Action="PlyraRestoreMachineFolder" Value="[PLYRA_MACHINE_DIR]" Before="PlyraRestoreUserFolder" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND PLYRA_MACHINE_DIR" />
  <Launch Condition="Installed OR ALLUSERS &lt;&gt; 1 OR NOT PLYRA_USER_DIR" Message="This app is already installed for your account. Choose Only for me to update it, or uninstall that copy before changing who it is installed for." />
  <Launch Condition="Installed OR ALLUSERS = 1 OR NOT PLYRA_MACHINE_DIR" Message="This app is already installed for everyone. Choose Everyone to update it, or pass ALLUSERS=1 to msiexec. Uninstall that copy before changing who it is installed for." />
  <UI>
    <TextStyle Id="PlyraScopeText" FaceName="Segoe UI" Size="9" />
    <TextStyle Id="PlyraScopeTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
    <Dialog Id="PlyraScopeDlg" Width="370" Height="220" Title="[ProductName] Setup" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="30" Text="{\PlyraScopeTitle}Who should use [ProductName]?" />
      <Control Id="Info" Type="Text" X="20" Y="50" Width="330" Height="30" Text="{\PlyraScopeText}An update keeps the existing folder. New copies use the Plyra folder under Programs." />
      <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="88" Width="330" Height="60" Property="PLYRA_SCOPE">
        <RadioButtonGroup Property="PLYRA_SCOPE">
          <RadioButton Value="user" X="0" Y="0" Width="330" Height="20" Text="Only for me (no administrator permission needed)" />
          <RadioButton Value="machine" X="0" Y="30" Width="330" Height="20" Text="Everyone on this computer (asks an administrator)" />
        </RadioButtonGroup>
      </Control>
      <Control Id="Next" Type="PushButton" X="214" Y="182" Width="66" Height="20" Default="yes" Text="Next">
        <Publish Property="ALLUSERS" Value="1" Order="1" Condition="PLYRA_SCOPE = &quot;machine&quot;" />
        <Publish Property="ALLUSERS" Value="{}" Order="2" Condition="PLYRA_SCOPE = &quot;user&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="3" Condition="PLYRA_SCOPE = &quot;machine&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="1" Order="4" Condition="PLYRA_SCOPE = &quot;user&quot;" />
        <Publish Event="EndDialog" Value="Return" Order="5" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="290" Y="182" Width="60" Height="20" Cancel="yes" Text="Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
    </Dialog>
  </UI>
  <InstallUISequence>
    <Show Dialog="PlyraScopeDlg" After="PlyraPreferMachineScope" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
    <!-- Related-product discovery runs once, so full UI must choose its context first. -->
    <FindRelatedProducts After="PlyraScopeDlg" />
  </InstallUISequence>
</Include>
