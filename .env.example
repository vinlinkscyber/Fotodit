# Fotodit AI Provider Configuration
# Add your API keys below (or provide them to the assistant to configure automatically).

# 1. Google Gemini (Primary Text & Reasoning, Imagen Fallback)
GEMINI_API_KEY=

# 2. OpenRouter (Multi-Model Frontier Router - Disabled by default: set to 1 to enable)
OPENROUTER_ENABLED=0
# OPENROUTER_API_KEY=

# 3. Cohere (Command A+ / High-Performance Reasoning)
COHERE_API_KEY=

# 4. Pollinations (Primary Fast Image Generation - Turbo)
POLLINATIONS_API_KEY=

# 5. Lajiwa (Engine Micro-tasks)
LAJIWA_API_KEY=
